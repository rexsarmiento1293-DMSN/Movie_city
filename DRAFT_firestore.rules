rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprint: UserProfile (/users/{userId})
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'studioRole', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'studioRole', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.studioRole is string && data.studioRole.size() >= 1 && data.studioRole.size() <= 40
        && (data.studioRole == 'Director' || data.studioRole == 'Screenwriter' || data.studioRole == 'Cinematographer' || data.studioRole == 'Producer')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: StudioProject (/projects/{projectId})
    function isValidStudioProject(data) {
      return data.keys().hasAll(['ownerId', 'title', 'category', 'genre', 'prompt', 'scriptText', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'title', 'category', 'genre', 'prompt', 'scriptText', 'status', 'createdAt', 'updatedAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 140
        && data.category is string && data.category.size() >= 1 && data.category.size() <= 20
        && (data.category == 'drama' || data.category == 'video' || data.category == 'image' || data.category == 'effects' || data.category == 'music')
        && data.genre is string && data.genre.size() >= 1 && data.genre.size() <= 60
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 2000
        && data.scriptText is string && data.scriptText.size() >= 0 && data.scriptText.size() <= 8000
        && data.status is string && data.status.size() >= 1 && data.status.size() <= 20
        && (data.status == 'draft' || data.status == 'published' || data.status == 'archived')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && request.auth.uid == userId
        && existing().uid == request.auth.uid
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'studioRole', 'updatedAt']);

      allow delete: if false;
    }

    // Collection: /projects/{projectId}
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId) && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidStudioProject(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));

      allow update: if isVerifiedUser()
        && isValidId(projectId)
        && isValidStudioProject(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && existing().status != 'archived'
        && (
          // Action 1: Edit project content
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'genre', 'prompt', 'scriptText', 'status', 'updatedAt'])
          ||
          // Action 2: Status transition only
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        );

      allow delete: if isVerifiedUser()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
